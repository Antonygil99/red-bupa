# Gestor de mapas y rutas (Mapbox). Todas las claves son PUBLIC_* porque el sitio es estático
# y se resuelven en el bundle del navegador: usa un token público restringido por dominio.
# Sin token la app usa mosaicos CARTO y no calcula rutas.
PUBLIC_MAPBOX_TOKEN=
PUBLIC_MAPBOX_STYLE=mapbox/light-v11
# walking | cycling | driving | driving-traffic
PUBLIC_ROUTING_PROFILE=driving
